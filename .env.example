# Supabase
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Existing Vercel projects can keep VITE_SUPABASE_ANON_KEY during key rotation.
# Both values are public application keys; never put a secret/service_role key here.

# Restaurant
VITE_RESTAURANT_NAME=طلة بحر
VITE_CURRENCY=₪
VITE_MENU_URL=https://your-app.vercel.app/menu
