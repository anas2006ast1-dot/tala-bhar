# Supabase
VITE_SUPABASE_URL=your_supabase_url
# Public browser key only (publishable preferred; anon key is accepted for legacy projects).
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Legacy alternative: VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_SUPABASE_ANON_KEY=your_anon_key

# Restaurant
VITE_RESTAURANT_NAME=طلة بحر
VITE_CURRENCY=₪
VITE_MENU_URL=https://your-app.vercel.app/menu

# Cloudflare Media Worker (public values only)
VITE_MEDIA_API_URL=https://tala-bahr-media.<account-subdomain>.workers.dev
VITE_R2_PUBLIC_URL=https://images.example.com
